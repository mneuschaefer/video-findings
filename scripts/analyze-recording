#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
project_dir=$(cd "$script_dir/.." && pwd)
video=""
transcript=""
output=""
language=auto
keyword_profile=en
frame_mode=single
motion_scan=on

usage() {
  cat <<'EOF'
Usage: scripts/analyze-recording --video PATH --output DIRECTORY [OPTIONS]

Options:
  --transcript PATH   Existing VTT/SRT, for example from a Teams recording
  --language CODE     Transcription language when no transcript exists (default: auto)
  --keyword-profile PROFILE  Optional heuristic profile: en, de, JSON path, or none
  --frame-mode MODE   single (default) or dense
  --no-motion-scan    Skip the compact numeric whole-video motion index
  -h, --help          Show this help

Examples:
  scripts/analyze-recording --video review.mov --output output/review
  scripts/analyze-recording --video teams.mp4 --transcript teams.vtt --output output/teams
EOF
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --video) video=${2:-}; shift 2 ;;
    --transcript) transcript=${2:-}; shift 2 ;;
    --output) output=${2:-}; shift 2 ;;
    --language) language=${2:-}; shift 2 ;;
    --keyword-profile) keyword_profile=${2:-}; shift 2 ;;
    --frame-mode) frame_mode=${2:-}; shift 2 ;;
    --no-motion-scan) motion_scan=off; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ "$frame_mode" != "single" && "$frame_mode" != "dense" ]]; then
  echo "Invalid --frame-mode: $frame_mode (expected single or dense)" >&2
  exit 2
fi

if [[ -z "$video" || -z "$output" ]]; then
  usage >&2
  exit 2
fi

check_args=(--video "$video")
if [[ -n "$transcript" ]]; then
  check_args+=(--transcript "$transcript")
else
  check_args+=(--require-transcription)
fi
"$script_dir/check-environment" "${check_args[@]}"

mkdir -p "$output/material"
if [[ -z "$transcript" ]]; then
  transcript="$output/material/transcript-source.vtt"
  "$script_dir/transcribe-local" "$video" "$transcript" "$language"
fi

python3 "$project_dir/src/video_findings.py" prepare \
  --video "$video" \
  --transcript "$transcript" \
  --output "$output" \
  --keyword-profile "$keyword_profile" \
  --frame-mode "$frame_mode"

if [[ "$motion_scan" == "on" ]]; then
  "$script_dir/build-motion-index" --video "$video" --output "$output/material"
fi

printf '\nFindings dossier: %s/Video Findings.md\n' "$output"
printf 'Preparation ready: %s/material/transcript-cues.json\n' "$output"
printf 'Readable transcript: %s/material/transcript.md\n' "$output"
if [[ "$motion_scan" == "on" ]]; then
  printf 'Motion index: %s/material/motion-1s.tsv\n' "$output"
fi
printf 'Structured data: %s/material/candidates.json\n' "$output"
printf 'Next: read transcript-cues.json once, extract and view useful images, then write a concise Video Findings.md. Structured findings.json and deeper investigation are optional, not required.\n'
