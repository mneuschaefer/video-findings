{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mneuschaefer/video-findings/templates/findings.schema.json",
  "title": "Video Findings results",
  "type": "object",
  "required": ["schema_version", "source_video", "transcript", "findings", "other_topics"],
  "properties": {
    "schema_version": {"const": 2},
    "source_video": {"type": ["string", "null"]},
    "transcript": {"type": "string"},
    "transcript_language": {"type": "string"},
    "report_language": {"type": "string"},
    "output_language": {
      "type": "string",
      "description": "Deprecated alias for report_language"
    },
    "quote_ui_language_policy": {
      "type": "string",
      "default": "preserve-original"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "time_ranges",
          "reported_issue",
          "detailed_description",
          "visible_state",
          "reviewer_intent",
          "transcript_evidence",
          "unknown_context",
          "uncertainty_notes",
          "representative_image",
          "image_timestamp",
          "image_caption",
          "original_video_timestamp"
        ],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "evidence_need": {"enum": ["static", "dynamic"]},
          "dynamic_mode": {
            "type": ["string", "null"],
            "enum": [null, "interaction", "flicker", "latency", "audio-visual", "slow4x"]
          },
          "time_ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": {"type": "number", "minimum": 0},
                "end": {"type": "number", "minimum": 0}
              }
            }
          },
          "reported_issue": {"type": "string"},
          "detailed_description": {
            "type": "string",
            "description": "One or two detailed dossier paragraphs grounded in reported and visible evidence"
          },
          "visible_state": {"type": ["string", "null"]},
          "reviewer_intent": {"type": ["string", "null"]},
          "observation": {"type": ["string", "null"]},
          "reviewer_expectation": {"type": ["string", "null"]},
          "transcript_evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "unknown_context": {
            "type": "array",
            "items": {"type": "string"}
          },
          "uncertainty_notes": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Only meaningful uncertainty such as unclear audio, ambiguity, or an explicit need to inspect again"
          },
          "interpretation": {"type": ["string", "null"]},
          "representative_image": {"type": ["string", "null"]},
          "image_timestamp": {"type": "number", "minimum": 0},
          "image_caption": {
            "type": "string",
            "description": "Short concrete description of what is visible in the representative image"
          },
          "original_video_timestamp": {"type": "number", "minimum": 0},
          "optional_clip": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "other_topics": {
      "type": "array",
      "description": "Timestamped index of useful transcript content that is not a finding; empty when none exists",
      "items": {
        "type": "object",
        "required": ["start", "end", "title", "summary"],
        "properties": {
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "title": {"type": "string"},
          "summary": {
            "type": "string",
            "description": "Short neutral description in the report language, not a full meeting summary"
          },
          "source_excerpt": {
            "type": ["string", "null"],
            "description": "Optional original-language excerpt"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
